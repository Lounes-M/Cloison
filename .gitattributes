# Les fins de ligne restent en LF partout, y compris dans la copie de travail
# Windows : Prettier est configure en `endOfLine: lf` et la CI tourne sous Linux.
* text=auto eol=lf

# Binaires : aucune conversion.
*.png binary
*.jpg binary
*.webp binary
*.ttf binary
*.woff binary
*.woff2 binary
*.ico binary

# Bruit inutile dans les diffs de PR.
package-lock.json linguist-generated=true -diff
design/home.artifact.html linguist-generated=true -diff
