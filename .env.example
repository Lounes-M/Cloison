# ---------------------------------------------------------------------------
# URL publique du site
# ---------------------------------------------------------------------------
# Rien a definir en principe : en local http://localhost:3000 est utilise, et
# sur Vercel le domaine de production est repris automatiquement, y compris le
# domaine personnalise des qu'il est rattache. Ne la definir que pour forcer
# une autre valeur. Sans barre oblique finale.
# NEXT_PUBLIC_SITE_URL=https://cloison.fr

# ---------------------------------------------------------------------------
# Supabase : region UE
# ---------------------------------------------------------------------------
# Tableau de bord Supabase > bouton Connect (en haut), ou Settings > API Keys.
#
# Seule la cle PUBLIABLE est utilisee (`sb_publishable_...`). La table
# `demandes_agence` n'autorise que l'insertion, jamais la lecture : meme
# divulguee, cette cle ne permet pas de lire la liste des agences prospectees.
#
# L'ancienne cle `anon` fonctionne encore ici : les deux prennent le role
# Postgres `anon` : mais Supabase la deprecie fin 2026.
#
# La cle SECRETE (`sb_secret_...`, anciennement `service_role`) NE DOIT PAS
# figurer ici ni ailleurs dans le depot : elle contourne entierement les
# politiques RLS. Si le projet en a besoin un jour, ce sera une decision
# documentee, pas un ajout discret.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Le secret JWT du projet, dans Settings > API. Il signe les jetons de capacite
# du garant et du locataire : c'est lui qui fait prendre a la connexion le role
# Postgres `porteur_lien`, donc lui qui rend le cloisonnement opposable.
#
# Secret au meme titre que la cle maitresse : jamais de prefixe NEXT_PUBLIC_,
# jamais dans le bloc `env` de next.config.ts.
SUPABASE_JWT_SECRET=

# ---------------------------------------------------------------------------
# Resend : notification d'une nouvelle demande d'agence
# ---------------------------------------------------------------------------
RESEND_API_KEY=

# Adresse qui recoit les demandes.
EMAIL_DESTINATAIRE=

# Expediteur. Tant que le domaine n'est pas verifie chez Resend, laisser la
# valeur par defaut `Cloison <onboarding@resend.dev>` en ne definissant rien.
#
# ATTENTION : cet expediteur par defaut ne livre qu'a l'adresse du compte
# Resend. Il suffit pour la notification des demandes d'agence, qui t'est
# adressee. Il ne suffit PAS pour les liens du locataire et du garant, qui
# partent vers n'importe quelle adresse : ceux-la exigent un domaine verifie
# chez Resend, et cette variable posee dessus.
# EMAIL_EXPEDITEUR=Cloison <bonjour@cloison.fr>

# ---------------------------------------------------------------------------
# La cle maitresse du coffre
# ---------------------------------------------------------------------------
# Elle scelle les cles de dossier, qui scellent elles-memes les pieces. C'est
# le secret le plus dangereux du produit.
#
# Elle vit chez Vercel et JAMAIS chez Supabase : le chiffre est d'un cote, la
# cle de l'autre, et compromettre l'un ne donne rien sans l'autre (ADR 0003).
# La ranger a cote du chiffre reviendrait a payer la complexite du chiffrement
# sans acheter aucune garantie.
#
# 32 octets en base64. A generer soi-meme, une seule fois :
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# La changer rend illisibles toutes les pieces deja scellees : la rotation est
# un travail a part, laisse ouvert par l'ADR 0003.
#
# REQUISE EN PRODUCTION depuis la limitation de debit partagee. Elle ne servait
# jusque-la qu'a des modules sans appelant ; le formulaire agence s'en sert
# maintenant a chaque envoi, pour marquer l'adresse IP avant de la compter. Sans
# elle, le formulaire repond « reessaie dans quelques minutes » a tout le monde.
CLE_MAITRESSE=

# ---------------------------------------------------------------------------
# Paiement (phase 6)
# ---------------------------------------------------------------------------
#
# Stripe, en mode test tant que le compte n'est pas active. La cle secrete ne
# porte jamais le prefixe NEXT_PUBLIC_ : Checkout est hebergee chez Stripe, le
# navigateur n'a besoin d'aucune cle.
STRIPE_SECRET_KEY=

# Le secret de signature du webhook, donne par Stripe a la creation du point de
# terminaison `https://<site>/api/paiement/webhook`, evenement
# `checkout.session.completed`. Sans lui, aucun paiement n'est jamais marque.
STRIPE_WEBHOOK_SECRET=
